{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "REALRHI_BUILD_TESTS": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "cpu",
      "inherits": "base",
      "displayName": "Core and render graph tests without the Vulkan SDK",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REALRHI_BUILD_VULKAN": false,
        "REALRHI_BUILD_GPU_TESTS": false,
        "BUILD_EXAMPLES": false
      }
    },
    {
      "name": "windows-base",
      "inherits": "base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "REALRHI_BUILD_VULKAN": true,
        "REALRHI_BUILD_GPU_TESTS": true,
        "REALRHI_BUILD_BENCHMARKS": true,
        "BUILD_EXAMPLES": true
      },
      "environment": {
        "PATH": "$penv{VULKAN_SDK}/Bin;$penv{PATH}"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "jobs": 4
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "jobs": 4
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/out/test-results/cpu.xml"
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "cpu"
        }
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/out/test-results/windows-debug.xml"
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-debug-cpu",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/out/test-results/windows-debug-cpu.xml"
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "cpu"
        }
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/out/test-results/windows-release.xml"
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-release-cpu",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/out/test-results/windows-release-cpu.xml"
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "cpu"
        }
      }
    },
    {
      "name": "windows-release-gpu",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/out/test-results/windows-release-gpu.xml"
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    }
  ]
}
